// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  OPEN
  CANCELLED
  CLOSED
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  fullName String  @map("full_name")
  email    String  @unique
  password String?
  mobile   String

  emailVerified Boolean @default(false)
  image         String?

  roleId   Int       @map("role_id")
  role     Role      @relation(fields: [roleId], references: [id])
  //refrences is for forign key
  sessions Session[]
  accounts Account[]

  managedDepartments Department[] @relation("DepartmentManager")

  departments DepartmentUser[]

  managedProjects Project[] @relation("ProjectManager")
  leadProjects    Project[] @relation("ProjectLead")

  projectTeams ProjectTeam[]

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  salaries Salary[]
  payrolls Payroll[]

  leaves LeaveManagement[]

  employee Employee?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String
  userAgent String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Designation {
  id String @id @default(uuid())
  post String 
  description String 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
}

model Leavetype {
  id String @id @default(uuid())
  type String 
  description String 
  leaves LeaveManagement[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

}

model EmployementType {
  id String @id @default(uuid())
  type String 
  description String 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
}



model Role {
  id Int @id @default(autoincrement())

  rolename String @unique
  rolecode Int    @unique

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Department {
  id Int @id @default(autoincrement())

  departmentName String @unique @map("department_name")
  departmentCode Int @unique @map("department_code")
  departmentUrl String? @map("department_url")
  managerId String? @map("manager_id")
  manager User? @relation("DepartmentManager" , fields:[managerId] , references:[id])

  users    DepartmentUser[]
  projects Project[]
  jobs     Job[]
  leaves   LeaveManagement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model DepartmentUser {
  id Int @id @default(autoincrement())

  userId       String @map("user_id")
  departmentId Int    @map("department_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, departmentId])
  @@map("department_users")
}

model Project {
  id Int @id @default(autoincrement())

  name        String
  description String?

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  cost   Decimal? @db.Decimal(10, 2)
  status String?

  managerId    String @map("manager_id")
  teamLeadId   String @map("team_lead_id")
  departmentId Int    @map("department_id")

  manager    User       @relation("ProjectManager", fields: [managerId], references: [id])
  teamLead   User       @relation("ProjectLead", fields: [teamLeadId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  tasks   Task[]
  members ProjectTeam[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectTeam {
  id Int @id @default(autoincrement())

  projectId Int    @map("project_id")
  userId    String @map("user_id")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, userId])
  @@map("project_team")
}

model Task {
  id Int @id @default(autoincrement())

  taskName        String  @map("task_name")
  taskDescription String? @map("task_description")

  storyPoint Int? @map("story_point")

  priority TaskPriority
  status   TaskStatus

  duration Int?

  projectId  Int    @map("project_id")
  assignedTo String @map("assigned_to")
  createdBy  String @map("created_by")

  project Project @relation(fields: [projectId], references: [id])

  assignedUser User @relation("AssignedTasks", fields: [assignedTo], references: [id])
  createdUser  User @relation("CreatedTasks", fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model Job {
  id Int @id @default(autoincrement())

  jobTitle       String  @map("job_title")
  jobDescription String? @map("job_description")

  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  applications JobApplication[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jobs")
}

model JobApplication {
  id Int @id @default(autoincrement())

  jobId Int @map("job_id")

  name    String
  email   String
  phone   String
  address String?

  experience Int?
  skills     String?

  currentCompany String? @map("current_company")
  noticePeriod   Int?    @map("notice_period")

  ctc         Decimal? @db.Decimal(10, 2)
  expectedCtc Decimal? @map("expected_ctc") @db.Decimal(10, 2)

  resumeLink  String? @map("resume_link")
  linkedinUrl String? @map("linkedin_url")

  status JobApplicationStatus

  job Job @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_application")
}

model Salary {
  id Int @id @default(autoincrement())

  amount Decimal @db.Decimal(10, 2)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salary")
}

model Payroll {
  id Int @id @default(autoincrement())

  amount Decimal @db.Decimal(10, 2)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  bankReceipt String? @map("bank_receipt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payroll")
}

model LeaveManagement {
  id Int @id @default(autoincrement())

  userId       String @map("user_id")
  departmentId Int    @map("department_id")

  approveStatus LeaveApprovalStatus @map("approve_status")

  fromDate DateTime? @map("from_date") @db.Date
  toDate   DateTime? @map("to_date") @db.Date

  purpose String?

  requestStatus LeaveRequestStatus @map("request_status")

  leaveTypeId String?    @map("leave_type_id")
  leaveType   Leavetype? @relation(fields: [leaveTypeId], references: [id])

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_management")
}

model Employee {
  id Int @id @default(autoincrement())
  
  experience Int?
  resumeLink String? @map("resume_link")
  linkedinUrl String? @map("linkedin_url")
  address String?
  
  accountNumber String? @map("account_number")
  ifscCode String? @map("ifsc_code")
  bankName String? @map("bank_name")
  branch String?

  leaveCount Int @default(0) @map("leave_count")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}
